---
/**
 * A short script and its result, side by side. The script runs at build time with the TypeScript
 * SDK, so the result shown is always what the engine prints; a failing script fails the build.
 */
import { Code } from '@astrojs/starlight/components';
import { KodiScript } from '@issadicko/kodi-script';
import { homeScript } from '../playground/home';
import { prettyPrint } from '../playground/result';
import { encodeShare } from '../playground/share';

const run = KodiScript.builder(homeScript).silentPrint(true).withMaxOperations(100_000).execute();
if (run.errorKind !== 'none') {
  throw new Error(`The home page script failed: ${run.errors.join('; ')}`);
}
const hasValue = run.value !== null && run.value !== undefined;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const playground = `${base}/playground/#${encodeShare({ script: homeScript })}`;
---

<div class="showcase not-content">
  <div class="source">
    <Code code={homeScript} lang="kodi" title="sales.kodi" />
  </div>
  <div class="result" role="region" aria-label="Result of the script">
    <div class="bar">
      <span class="dot" aria-hidden="true"></span>
      Run
    </div>
    <div class="body">
      {
        run.output.length > 0 && (
          <>
            <h3>Output</h3>
            <pre>{run.output.join('\n')}</pre>
          </>
        )
      }
      {
        hasValue && (
          <>
            <h3>Result</h3>
            <pre>{prettyPrint(run.value)}</pre>
          </>
        )
      }
    </div>
    <a class="open" href={playground}>Open in the playground<span aria-hidden="true"> &rarr;</span></a>
  </div>
</div>

<style>
  .showcase {
    display: grid;
    gap: 1rem;
    align-items: stretch;
    margin-block: 1.5rem;
  }
  @media (min-width: 50rem) {
    .showcase {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }
  }
  .source,
  .source :global(figure),
  .source :global(.expressive-code) {
    height: 100%;
    margin: 0;
  }
  .source :global(.expressive-code) {
    margin-block: 0;
  }
  .source :global(figure),
  .source :global(pre) {
    height: 100%;
  }
  .result {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--sl-color-green);
  }
  .body {
    flex: 1;
    padding: 0.75rem 1rem;
  }
  h3 {
    margin: 0.5rem 0 0.25rem;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
  }
  h3:first-child {
    margin-top: 0;
  }
  pre {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-code);
    line-height: 1.6;
    white-space: pre-wrap;
    color: var(--sl-color-white);
  }
  .open {
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .open:hover {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }
</style>
