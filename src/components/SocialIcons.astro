---
/** Header links: the Playground, a separate full-screen page, next to the GitHub icon. */
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a class="playground-link" href={`${base}/playground/`}>
  <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path d="M4 2.5v11l9-5.5z" fill="currentColor"></path></svg>
  Playground
</a>
<Default {...Astro.props} />

<style>
  .playground-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 999px;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .playground-link:hover {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }
</style>
